<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification tray icon — must be white on transparent per Android spec.
  Matches the Niyam N lettermark style (stroke + dot).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- N stroke -->
    <path
        android:pathData="M5,19 L5,5 L19,19 L19,5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Dot at top-right of N (cx=19, cy=5, r=1.5) -->
    <path
        android:pathData="M19,5 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:fillColor="#FFFFFF"/>

</vector>
