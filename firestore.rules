rules_version = '2';

// Each signed-in user may read/write only their own data.
//   users/{uid}               → profile/settings + `_rev` revision counter
//   users/{uid}/parts/{part}  → one document per large collection ({ items: [...] })
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid);
      allow delete: if isOwner(uid);

      match /parts/{part} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && part in ['habits', 'expenses', 'budgets', 'notes', 'savedCounts',
                      'focusSessions', 'reminders', 'moods', 'breathingSessions', 'journalLogs']
          && request.resource.data.keys().hasOnly(['items'])
          && request.resource.data.items is list;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
